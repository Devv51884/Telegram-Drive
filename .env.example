# ==========================================
# TeleDrive Environment Configuration
# ==========================================

# 1. Telegram Bot Storage Configuration (Get from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here
STORAGE_CHAT_ID=-100xxxxxxxxxx

# 2. Telegram MTProto Account API (Get from https://my.telegram.org -> API development tools)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# 3. Supabase Cloud Database (Get from https://supabase.com -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 4. Master Application Secret (Optional: Auto-generated if omitted)
# APP_SECRET=your_random_64_character_hex_secret

# 5. Server Port
PORT=5000

# 6. Real-Time Email Delivery (Signup Links & Password Resets)
# RECOMMENDED FOR RENDER & CLOUD: Brevo API (Free 300 emails/day, 100% bypasses host SMTP blocks)
# Get free API key in 30 seconds at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend API (Free 3,000 emails/month): https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Or Gmail SMTP (Works on Local/VPS - blocked on Render free tier):
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_digit_google_app_password

# Or custom SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM="TeleDrive Cloud" <your_email@gmail.com>
