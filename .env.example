# ==========================================
# TeleDrive Environment Configuration
# ==========================================

# 1. Telegram Bot Storage Configuration (Get from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here
STORAGE_CHAT_ID=-100xxxxxxxxxx

# 2. Telegram MTProto Account API (Get from https://my.telegram.org -> API development tools)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# 3. Supabase Cloud Database (Get from https://supabase.com -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 4. Master Application Secret (Optional: Auto-generated if omitted)
# APP_SECRET=your_random_64_character_hex_secret

# 5. Server Port
PORT=5000
